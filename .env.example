# ==============================================================================
# SmartStock-AI: Environment Configuration
# ==============================================================================

# Database Path (Optional, defaults to ./inventory_ai.db)
# INVENTORY_DB_PATH=inventory_ai.db

# JWT Secret Key
SECRET_KEY=inventory-ai-secret-key-tamilnadu-2026

# ------------------------------------------------------------------------------
# FREE LLM & AGENTIC COPILOT CONFIGURATION
# ------------------------------------------------------------------------------
# Options: 'auto', 'gemini', 'groq', 'ollama', 'built_in'
# 'auto' automatically selects Gemini or Groq if their API key is set, else local.
LLM_PROVIDER=auto

# 1. Google Gemini (100% Free - 1,500 requests/day from https://aistudio.google.com/)
# Recommended model: gemini-2.5-flash or gemini-1.5-flash
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 2. Groq Cloud (100% Free - 14,400 requests/day from https://console.groq.com/)
# Recommended model: llama-3.3-70b-versatile or llama-3.1-8b-instant
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# 3. Ollama (100% Free Local Offline from https://ollama.com/)
# Run: ollama run llama3.2
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
